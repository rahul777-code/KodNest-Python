limit = int(input("Enter the number:"))
target = int(input("Enter the number:"))

count = 0
total = 0
found = False

for i in range(1, limit + 1):
    if i % 3 == 0:
        count += 1
        total += i
        if i == target:
            found = True

print(f"Count: {count}")
print(f"Sum: {total}")
print(f"Target Found: {'Yes' if found else 'No'}")